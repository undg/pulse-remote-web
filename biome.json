{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": false },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "expand": "auto",
    "useEditorconfig": true,
    "includes": ["**", "!**/pnpm-lock.yaml"]
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "none" },
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.DS_Store",
      "!**/dist",
      "!**/dist-ssr",
      "!**/*.local",
      "!**/.eslintcache",
      "!**/coverage",
      "!**/.nyc_output",
      "!**/.stylelintcache",
      "!cypress/videos"
    ]
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "single",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded",
      "bracketSameLine": false,
      "quoteStyle": "single",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    "formatter": {
      "indentScriptAndStyle": false,
      "selfCloseVoidElements": "always"
    }
  },
  "overrides": [
    {
      "includes": ["src/**/*.ts", "src/**/*.tsx"],
      "javascript": { "globals": [] },
      "linter": {
        "rules": {
          "complexity": {
            "noImplicitCoercions": "error",
            "noUselessFragments": "error",
            "noVoid": "off",
            "useRegexLiterals": "error"
          },
          "correctness": {
            "noConstructorReturn": "error",
            "noInvalidUseBeforeDeclaration": "off",
            "noUndeclaredDependencies": "error",
            "noUnusedImports": "error",
            "noUnusedVariables": "warn",
            "useJsxKeyInIterable": "error"
          },
          "performance": { "noJsxPropsBind": "off" },
          "security": { "noGlobalEval": "error", "noScriptUrl": "error" },
          "style": {
            "noMagicNumbers": "off",
            "noNonNullAssertion": "error",
            "noParameterAssign": "off",
            "noRestrictedImports": "error",
            "useConsistentArrowReturn": "off",
            "useConsistentCurlyBraces": "off",
            "useConsistentTypeDefinitions": "off",
            "useDestructuring": "off",
            "useEnumInitializers": "off",
            "useGroupedAccessorPairs": "error"
          },
          "suspicious": {
            "noDeprecatedImports": "error",
            "noDuplicateElseIf": "error",
            "noTsIgnore": "error",
            "noUselessRegexBackrefs": "error",
            "useDefaultSwitchClauseLast": "error"
          },
          "nursery": {
            "useSortedClasses": {
              "level": "warn",
              "options": {
                "attributes": ["className", "class", "cn"],
                "functions": ["cn", "clsx", "cva", "twMerge", "twJoin"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["vite.config.ts", "cypress.config.ts"],
      "javascript": { "globals": [] }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  }
}
